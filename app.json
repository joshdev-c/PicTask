{
  "expo": {
    "name": "PicTask",
    "slug": "pictask",
    "scheme": "pictask",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "PicTask uses your camera only to scan a document you choose.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PicTask uses selected photos only to create your document task."
        }
      ],
      "expo-local-authentication",
      "expo-notifications",
      "expo-secure-store",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pictask.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "expo-navigation-bar": {
        "enforceContrast": false
      },
      "eas": {
        "projectId": "5f240cbc-58a7-4d79-bed1-1163cbff7bea"
      }
    }
  }
}
